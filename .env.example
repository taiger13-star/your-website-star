# Local infrastructure
POSTGRES_DB=noir_atelier
POSTGRES_USER=noir
POSTGRES_PASSWORD=change-me-local-postgres
DATABASE_URL=postgresql://noir:change-me-local-postgres@localhost:5450/noir_atelier

MINIO_ROOT_USER=noir-minio
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_ENDPOINT=http://localhost:6300
MINIO_PUBLIC_URL=http://localhost:6300
MINIO_BUCKET=noir-catalog

# Generate 32 Latin letters for the private admin URL, e.g. node -e "..."
ADMIN_ROUTE_TOKEN=replacewiththirtytworandomlatinletters
ADMIN_PASSWORD=change-me-before-using-admin
SESSION_SECRET=replace-with-a-long-random-secret

# Temporary code mode. Switch to smtp before using real email verification.
AUTH_EMAIL_MODE=stub
# Customer account emails for AUTH_EMAIL_MODE=smtp.
PUBLIC_SITE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# CDEK delivery. Keep the client secret on the server only.
# Until production API access is received, keep `mock`; set to `live` after
# adding both credentials. Missing credentials also use the test responses.
CDEK_MODE=mock
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Moscow in the CDEK location directory.
CDEK_ORIGIN_CITY_CODE=44

# Browser-safe key, restricted by HTTP Referer in the Yandex Maps console.
VITE_YANDEX_MAPS_API_KEY=

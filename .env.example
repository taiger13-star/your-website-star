# Local infrastructure
POSTGRES_DB=noir_atelier
POSTGRES_USER=noir
POSTGRES_PASSWORD=change-me-local-postgres
DATABASE_URL=postgresql://noir:change-me-local-postgres@localhost:5450/noir_atelier

MINIO_ROOT_USER=noir-minio
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_ENDPOINT=http://localhost:6300
MINIO_PUBLIC_URL=http://localhost:6300
MINIO_BUCKET=noir-catalog

# Generate 32 Latin letters for the private admin URL, e.g. node -e "..."
ADMIN_ROUTE_TOKEN=replacewiththirtytworandomlatinletters
ADMIN_PASSWORD=change-me-before-using-admin
SESSION_SECRET=replace-with-a-long-random-secret

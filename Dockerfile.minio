# MinIO stopped publishing generally available container images.  Build the
# official, pinned release locally instead of relying on an external registry.
FROM golang:1.24-alpine AS build

ARG MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z

RUN apk add --no-cache git ca-certificates \
  && git clone --depth 1 --branch "$MINIO_VERSION" https://github.com/minio/minio.git /src/minio

WORKDIR /src/minio
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/minio ./main.go

FROM alpine:3.22

RUN apk add --no-cache ca-certificates
COPY --from=build /out/minio /usr/local/bin/minio

ENTRYPOINT ["minio"]
